# Copia este archivo a ".env" y completa los valores según tu instalación
# de PostgreSQL:   cp .env.example .env
# El archivo ".env" NO se sube a git (ver .gitignore);
# --- Conexión a la base de datos (PostgreSQL) ---

# Dirección donde corre tu servidor de PostgreSQL.
# Si lo instalaste en tu propia máquina, es "localhost".
DB_HOST=localhost

# Puerto donde escucha PostgreSQL. 5432 es el puerto por defecto.
DB_PORT=5432

# Usuario de PostgreSQL con permisos sobre la base de datos.
# "postgres" es el usuario administrador que se crea por defecto al instalar.
DB_USER=postgres

# Contraseña del usuario anterior (la que definiste al instalar PostgreSQL).
DB_PASS=12345


# Nombre de la base de datos que vas a crear y cargar con Sakila
# (ver sql/ y el README para los pasos).
DB_NAME= northwind

# --- Configuración de la API ---

# Entorno en el que corre la aplicación: "development" o "production".
# El código puede leer esta variable para activar o desactivar cosas según
# el entorno; por ejemplo, aquí Swagger (/api-docs) solo se activa cuando
# NODE_ENV no es "production".
NODE_ENV=development

# Puerto donde va a correr este servidor Express.
PORT=3000

# Clave secreta usada para firmar y verificar los tokens JWT (login).
# Cambia este valor y no lo compartas ni lo subas al repositorio.
JWT_SECRET=supersecreto

# Tiempo de expiración de los tokens JWT.
# Formato aceptado por jsonwebtoken/ms: un número con unidad, p. ej. "1h", "30m", "7d".
# Si la ponés sin unidad (p. ej. "3600") se interpreta en MILISEGUNDOS, no segundos.
# Si esta variable no está definida, el código usa "1h" por defecto.
JWT_TIME_EXPIRE=1h
