@baseUrl = http://localhost:3000


### 01 - GET Customers
GET {{baseUrl}}/customers


### 02 - GET Employees
GET {{baseUrl}}/employees


### 03 - GET Available Products
GET {{baseUrl}}/products?available=true


### 04 - GET Created Order
GET {{baseUrl}}/orders/11078


### 05 - POST Create Order
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customer_id": "ALFKI",
  "employee_id": 1,
  "order_date": "2026-09-13",
  "required_date": "2026-09-20",
  "products": [
    {
      "product_id": 3,
      "quantity": 1,
      "discount": 0
    },
    {
      "product_id": 40,
      "quantity": 1,
      "discount": 0.1
    }
  ]
}


